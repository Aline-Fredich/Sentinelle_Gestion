# ==============================================================================
# SENTINEL GESTION - Variables d'environnement de référence
# ==============================================================================

# Application & Domaine
NEXT_PUBLIC_APP_NAME="SENTINEL GESTION"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr-FR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Europe/Paris"
NEXT_PUBLIC_DEFAULT_CURRENCY="EUR"

# Base de données (pour la Phase 1 / Prisma / PostgreSQL)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel_gestion?schema=public"

# Authentification (NextAuth / Auth.js)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"

# Stockage d'objets (S3 / Supabase Storage pour les documents)
# STORAGE_ENDPOINT=""
# STORAGE_BUCKET="sentinel-documents"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
