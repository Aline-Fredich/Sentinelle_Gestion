# ==============================================================================
# SENTINEL GESTION - Variables d'environnement de référence
# ==============================================================================

# Application & Domaine
NEXT_PUBLIC_APP_NAME="SENTINEL GESTION"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr-FR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Europe/Paris"
NEXT_PUBLIC_DEFAULT_CURRENCY="EUR"

# Supabase (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Stockage d'objets (Supabase Storage)
NEXT_PUBLIC_STORAGE_BUCKET_DOCUMENTS="sentinel-documents"
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS="sentinel-avatars"
